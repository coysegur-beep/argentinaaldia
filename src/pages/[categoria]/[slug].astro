---
import type { GetStaticPaths } from 'astro';
import SiteShell from '../../layouts/SiteShell.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import SanityImage from '../../components/SanityImage.astro';
import AiDisclosure from '../../components/AiDisclosure.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { articles, getRelated } from '../../data/content';
import { formatDate, formatTime } from '../../lib/format';
import {
  newsArticleSchema,
  breadcrumbSchema,
  absoluteUrl,
  buildPageTitle,
  buildPageDescription,
} from '../../lib/seo';

export const getStaticPaths = (() => {
  return articles.map((a) => ({
    params: { categoria: a.categoria.slug, slug: a.slug },
    props: { article: a },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const related = getRelated(article, 3);

const fechaPub = new Date(article.fechaPublicacion);
const fechaAct = article.fechaActualizacion
  ? new Date(article.fechaActualizacion)
  : null;
const ONE_HOUR = 60 * 60 * 1000;
const showActualizado =
  fechaAct !== null && fechaAct.getTime() - fechaPub.getTime() > ONE_HOUR;

const siteOrigin = Astro.site ?? new URL('/', Astro.url);
const articlePath = `/${article.categoria.slug}/${article.slug}`;
const absoluteUrlStr = absoluteUrl(articlePath, siteOrigin);

const articleSchema = newsArticleSchema(article, siteOrigin);
const breadcrumb = breadcrumbSchema(
  [
    { name: 'Inicio', url: '/' },
    { name: article.categoria.nombre, url: `/${article.categoria.slug}` },
    { name: article.titulo, url: articlePath },
  ],
  siteOrigin,
);
---

<SiteShell
  title={buildPageTitle(article.titulo)}
  description={buildPageDescription(article.copete)}
  activeSection={article.categoria.slug}
  ogType="article"
  ogImage={article.imagenPrincipal.src}
  ogImageAlt={article.imagenPrincipal.alt}
  article={{
    publishedTime: article.fechaPublicacion,
    modifiedTime: article.fechaActualizacion,
    authorName: article.autor.nombre,
    section: article.categoria.nombre,
    tags: article.tags,
  }}
  jsonLd={[articleSchema, breadcrumb]}
>
  <article class="bg-white">
    <header class="border-b border-ink/10">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
        <a
          href={`/${article.categoria.slug}`}
          class="inline-block font-sans text-[11px] font-medium uppercase tracking-[0.18em]"
          style={`color: ${article.categoria.colorAccent}`}
        >
          {article.categoria.nombre}
        </a>
        {
          article.kicker && (
            <p class="mt-2 font-sans text-[11px] uppercase tracking-[0.18em] text-carbon/60">
              {article.kicker}
            </p>
          )
        }
        <h1
          class="mt-3 font-serif text-3xl leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl"
        >
          {article.titulo}
        </h1>
        <p
          class="mt-5 font-serif text-lg leading-relaxed text-carbon sm:text-xl"
        >
          {article.copete}
        </p>

        <address
          class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 font-sans text-sm not-italic text-carbon"
        >
          <a
            href={`/autor/${article.autor.slug}`}
            rel="author"
            class="group flex items-center gap-2"
          >
            <SanityImage
              image={{
                src: article.autor.foto,
                alt: `Foto de ${article.autor.nombre}`,
              }}
              sizes="36px"
              widths={[36, 72, 108]}
              aspectRatio={1}
              class="h-9 w-9 rounded-full object-cover"
            />
            <span
              class="font-medium text-ink transition-colors group-hover:text-celeste-dark"
            >
              {article.autor.nombre}
            </span>
          </a>
          <span class="text-carbon/40" aria-hidden="true">·</span>
          <span>{article.tiempoLectura} min de lectura</span>
          <span class="text-carbon/40" aria-hidden="true">·</span>
          <time datetime={article.fechaPublicacion}>
            {formatDate(fechaPub, { day: 'numeric', month: 'long', year: 'numeric' })}
            · {formatTime(fechaPub)}
          </time>
        </address>

        {
          showActualizado && fechaAct && (
            <p class="mt-2 font-sans text-xs italic text-carbon/70">
              Actualizado:{' '}
              <time datetime={article.fechaActualizacion}>
                {formatDate(fechaAct, { day: 'numeric', month: 'long' })},{' '}
                {formatTime(fechaAct)}
              </time>
            </p>
          )
        }
      </div>
    </header>

    <figure class="mx-auto my-8 max-w-3xl px-4 sm:my-10 sm:px-6 lg:px-8">
      <SanityImage
        image={article.imagenPrincipal}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1200px"
        loading="eager"
        fetchpriority="high"
        aspectRatio={16 / 9}
        class="block h-auto w-full"
      />
      {
        article.imagenPrincipal.caption && (
          <figcaption class="mt-2 font-sans text-[13px] leading-relaxed text-carbon/70">
            {article.imagenPrincipal.caption}
          </figcaption>
        )
      }
    </figure>

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pb-10 sm:pb-14">
      {article.ai_generated && <AiDisclosure />}
      <PortableTextRenderer blocks={article.contenido} />
    </div>

    <footer class="border-t border-ink/10">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-8">
        {
          article.tags.length > 0 && (
            <div>
              <h2 class="mb-3 font-sans text-[11px] font-medium uppercase tracking-[0.18em] text-celeste-dark">
                Etiquetas
              </h2>
              <ul class="flex flex-wrap gap-2">
                {article.tags.map((t) => (
                  <li>
                    <span class="inline-block border border-ink/10 bg-bone px-2.5 py-1 font-sans text-xs text-carbon">
                      #{t}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div>
          <h2 class="sr-only">Compartir</h2>
          <ShareButtons url={absoluteUrlStr} title={article.titulo} />
        </div>
      </div>
    </footer>
  </article>

  {
    related.length > 0 && (
      <aside class="border-t border-ink/10 bg-bone py-10 sm:py-14">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2 class="mb-6 font-serif text-2xl text-ink">Notas relacionadas</h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
            {related.map((r) => (
              <ArticleCard article={r} variant="default" />
            ))}
          </div>
        </div>
      </aside>
    )
  }
</SiteShell>
