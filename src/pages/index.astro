---
import SiteShell from '../layouts/SiteShell.astro';
import CoverStory from '../components/CoverStory.astro';
import WhatMatters from '../components/WhatMatters.astro';
import OpinionSection from '../components/OpinionSection.astro';
import LatestDispatches from '../components/LatestDispatches.astro';
import InvestigationSection from '../components/InvestigationSection.astro';
import MostRead from '../components/MostRead.astro';
import OurView from '../components/OurView.astro';

import {
  getCoverArticle,
  getDestacadas,
  getOpinion,
  getLatest,
  getMostRead,
  getInvestigaciones,
  getJudiciales,
} from '../data/content';
import { newsMediaOrganizationSchema } from '../lib/seo';

const cover = getCoverArticle();
// Excluir el cover de las destacadas para evitar duplicación visual.
const destacadas = getDestacadas(4).filter((a) => a.slug !== cover?.slug).slice(0, 3);
const opinion = getOpinion(3);
const ultimas = getLatest(3);
const investigaciones = getInvestigaciones(6);
const judiciales = getJudiciales(5);
const masLeidas = getMostRead(5);

const siteOrigin = Astro.site ?? new URL('/', Astro.url);
const orgSchema = newsMediaOrganizationSchema(siteOrigin);
---

<SiteShell
  title="Argentina al día — Las noticias de Argentina, todos los días"
  description="Diario digital de cobertura federal: política, economía, sociedad, cultura, deportes y agro desde todas las provincias. Periodismo independiente, editado."
  ogType="website"
  jsonLd={orgSchema}
>
  {cover && <CoverStory article={cover} />}
  {cover && <div class="h-[2px] w-full bg-celeste" aria-hidden="true" />}
  <WhatMatters articles={destacadas} />
  <OpinionSection articles={opinion} />
  <LatestDispatches articles={ultimas} />
  <InvestigationSection investigaciones={investigaciones} judiciales={judiciales} />
  <MostRead articles={masLeidas} />
  <OurView
    titulo="Por qué seguimos leyendo el diario"
    declaracion="En el ruido de los algoritmos, los WhatsApp en cadena y los influencers que opinan sin chequear, el diario sigue siendo el lugar donde alguien mira los datos, llama a la fuente y pone la firma. No es nostalgia: es el contrato de mínima entre quien escribe y quien lee. Lo seguimos cumpliendo."
  />
</SiteShell>
