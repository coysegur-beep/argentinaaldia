---
import SiteShell from '../layouts/SiteShell.astro';
import { articles } from '../data/content';

const searchData = articles.map((a) => ({
  titulo: a.titulo,
  copete: a.copete,
  href: `/${a.categoria.slug}/${a.slug}`,
  categoria: { nombre: a.categoria.nombre, color: a.categoria.colorAccent },
  autor: a.autor.nombre,
  fecha: a.fechaPublicacion,
  imagen: a.imagenPrincipal.src,
  alt: a.imagenPrincipal.alt,
  tiempoLectura: a.tiempoLectura,
  tags: a.tags,
}));

// Escapamos `<` para que ningún `</script>` rompa la inyección JSON.
const searchJson = JSON.stringify(searchData).replace(/</g, '\\u003c');
---

<SiteShell
  title="Buscar — Argentina al día"
  description="Buscador de notas de Argentina al día"
  noindex={true}
>
  <header class="border-b border-ink/10 bg-bone">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <p
        class="font-sans text-[11px] font-medium uppercase tracking-[0.18em] text-celeste-dark"
      >
        Buscador
      </p>
      <h1
        class="mt-3 font-serif text-4xl leading-none tracking-tight text-ink sm:text-5xl"
      >
        Buscar
      </h1>
      <div class="mt-4 h-[2px] w-16 bg-celeste" aria-hidden="true"></div>
      <form id="search-form" class="mt-6">
        <label for="q" class="sr-only">
          Buscar por título, copete o etiqueta
        </label>
        <input
          id="q"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Buscar por título, copete o etiqueta…"
          class="w-full border border-ink/15 bg-white px-4 py-3 font-sans text-base text-ink placeholder:text-carbon/50 focus:border-celeste-dark focus:outline-none"
        />
      </form>
      <p
        id="search-status"
        class="mt-4 font-sans text-xs text-carbon/70"
        aria-live="polite"
      >
        Empezá a escribir para buscar entre las notas publicadas.
      </p>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div
      id="search-results"
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3"
    >
    </div>
    <p
      id="search-empty"
      class="hidden py-10 text-center font-sans text-base text-carbon/70"
    >
      No encontramos notas que coincidan. Probá con otra palabra clave.
    </p>
  </main>

  <script
    id="search-data"
    type="application/json"
    is:inline
    set:html={searchJson}
  />

  <script is:inline>
    (function () {
      const dataEl = document.getElementById('search-data');
      const data = dataEl ? JSON.parse(dataEl.textContent) : [];
      const form = document.getElementById('search-form');
      const input = document.getElementById('q');
      const results = document.getElementById('search-results');
      const status = document.getElementById('search-status');
      const empty = document.getElementById('search-empty');

      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          }[c];
        });
      }

      function cardHtml(it) {
        return (
          '<article>' +
            '<a href="' + escapeHtml(it.href) + '" class="group block">' +
              '<div class="aspect-[16/10] overflow-hidden bg-black/5">' +
                '<img src="' + escapeHtml(it.imagen) + '" alt="' + escapeHtml(it.alt) + '" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" loading="lazy" />' +
              '</div>' +
              '<div class="mt-3">' +
                '<span class="inline-block px-2 py-0.5 text-[10px] font-medium uppercase tracking-[0.18em] text-white" style="background-color:' + escapeHtml(it.categoria.color) + '">' + escapeHtml(it.categoria.nombre) + '</span>' +
                '<h3 class="mt-2 font-serif text-xl leading-snug text-[#0A0A0A] transition-colors group-hover:text-[#2E5C8A]">' + escapeHtml(it.titulo) + '</h3>' +
                '<p class="mt-2 font-sans text-[11px] uppercase tracking-[0.18em] text-[#2C2C2A]/70">' + escapeHtml(it.autor) + ' · ' + escapeHtml(it.tiempoLectura) + ' min</p>' +
              '</div>' +
            '</a>' +
          '</article>'
        );
      }

      function render(items) {
        if (items.length === 0) {
          results.innerHTML = '';
          empty.classList.remove('hidden');
          status.textContent = 'Sin resultados.';
          return;
        }
        empty.classList.add('hidden');
        status.textContent = items.length + (items.length === 1 ? ' resultado' : ' resultados');
        results.innerHTML = items.map(cardHtml).join('');
      }

      function search(q) {
        const query = q.trim().toLowerCase();
        if (query.length === 0) {
          results.innerHTML = '';
          empty.classList.add('hidden');
          status.textContent = 'Empezá a escribir para buscar entre las notas publicadas.';
          return;
        }
        const filtered = data.filter(function (a) {
          const haystack = (a.titulo + ' ' + a.copete + ' ' + a.tags.join(' ') + ' ' + a.autor).toLowerCase();
          return haystack.indexOf(query) !== -1;
        });
        render(filtered);
      }

      input.addEventListener('input', function (e) {
        search(e.target.value);
      });
      form.addEventListener('submit', function (e) {
        e.preventDefault();
      });

      const url = new URL(window.location.href);
      const initialQ = url.searchParams.get('q');
      if (initialQ) {
        input.value = initialQ;
        search(initialQ);
      }
    })();
  </script>
</SiteShell>
