---
import SiteShell from '../layouts/SiteShell.astro';

const title = 'Cookies - Argentina al día';
const description =
  'Política de cookies de Argentina al día. Cómo usamos cookies para mejorar la navegación y cómo desactivarlas desde tu navegador.';

const proseP =
  'font-serif text-[16px] leading-[1.7] text-carbon sm:text-[17px] lg:text-[18px]';
---

<SiteShell title={title} description={description} canonical="/cookies">
  <main class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12 sm:py-20 lg:py-24">
    <header class="text-center">
      <p class="font-sans text-[12px] font-medium uppercase tracking-widest text-celeste-dark sm:text-[13px]">
        Legal
      </p>
      <div
        class="mx-auto my-4 h-[2px] w-16 bg-celeste-dark sm:w-20"
        aria-hidden="true"
      >
      </div>
      <h1
        class="font-serif text-[36px] font-medium leading-[1.1] tracking-tight text-ink sm:text-[48px] lg:text-[60px]"
      >
        Cookies
      </h1>
      <p class="mt-6 font-sans text-[13px] uppercase tracking-wider text-carbon/70">
        Última actualización: 7 de mayo de 2026
      </p>
    </header>
    <hr class="mt-12 border-t border-carbon/15" />

    <div class="pt-10 pb-8 sm:pb-12">
      <p class={proseP}>
        Nuestro sitio utiliza cookies para mejorar la navegación, analizar el
        tráfico y personalizar la experiencia del usuario. Las cookies
        permiten recordar preferencias y recopilar estadísticas de uso del
        portal.
      </p>
      <p class={`mt-5 sm:mt-6 ${proseP}`}>
        El usuario puede desactivar las cookies desde la configuración de su
        navegador, aunque algunas funciones del sitio podrían verse afectadas.
      </p>
      <p class={`mt-5 sm:mt-6 ${proseP}`}>
        Para más información sobre cómo gestionar las cookies en tu
        navegador, visitá la página oficial de tu navegador (Chrome, Firefox,
        Safari, Edge).
      </p>
    </div>
  </main>
</SiteShell>
