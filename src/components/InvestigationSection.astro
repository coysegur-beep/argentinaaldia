---
import type { Article } from '../types';
import { formatDate } from '../lib/format';
import SanityImage from './SanityImage.astro';

interface Props {
  investigaciones: Article[];
  judiciales: Article[];
}

const { investigaciones, judiciales } = Astro.props;

function fechaCorta(iso: string): string {
  return formatDate(iso, {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
}

const hayContenido = investigaciones.length > 0 || judiciales.length > 0;
---

{
  hayContenido && (
    <section
      aria-labelledby="investigacion-heading"
      class="bg-bone py-12 sm:py-16 lg:py-20"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="mb-10 text-center sm:mb-12">
          <h2
            id="investigacion-heading"
            class="font-sans text-[14px] font-medium uppercase tracking-widest text-ink sm:text-[15px]"
          >
            Investigación
          </h2>
          <div
            class="mt-3 h-[2px] w-full bg-celeste sm:mt-4"
            aria-hidden="true"
          />
        </header>

        <div class="grid grid-cols-1 gap-12 lg:grid-cols-4 lg:gap-x-12">
          {investigaciones.length > 0 && (
            <div class="lg:col-span-3">
              <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-12">
                {investigaciones.map((a) => (
                  <article>
                    <a
                      href={`/${a.categoria.slug}/${a.slug}`}
                      class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-celeste"
                    >
                      <div class="overflow-hidden">
                        <SanityImage
                          image={a.imagenPrincipal}
                          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw"
                          widths={[320, 480, 640, 800]}
                          aspectRatio={16 / 9}
                          class="block h-auto w-full transition-transform duration-300 group-hover:scale-105"
                        />
                      </div>
                      <h3 class="mt-4 font-serif text-[19px] font-medium leading-[1.3] text-ink transition-colors duration-150 group-hover:text-celeste-dark sm:text-[22px]">
                        {a.titulo}
                      </h3>
                      <div class="mt-3 flex items-center gap-2">
                        <span class="font-sans text-[11px] font-medium uppercase tracking-wider text-celeste-dark">
                          Investigación
                        </span>
                        <span class="text-carbon/40" aria-hidden="true">
                          ·
                        </span>
                        <time
                          datetime={a.fechaPublicacion}
                          class="font-sans text-[11px] text-carbon/70"
                        >
                          {fechaCorta(a.fechaPublicacion)}
                        </time>
                      </div>
                      <p class="mt-3 line-clamp-3 font-sans text-sm leading-relaxed text-carbon sm:text-[15px]">
                        {a.copete}
                      </p>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          )}

          {judiciales.length > 0 && (
            <aside
              aria-labelledby="judiciales-heading"
              class="border border-carbon/15 bg-bone p-6 sm:p-8 lg:col-span-1"
            >
              <header class="mb-6 text-center">
                <h3
                  id="judiciales-heading"
                  class="font-sans text-[13px] font-medium uppercase tracking-widest text-ink sm:text-[14px]"
                >
                  Artículos Judiciales
                </h3>
                <div
                  class="mt-3 h-[2px] w-full bg-celeste"
                  aria-hidden="true"
                />
              </header>
              <ul>
                {judiciales.map((a) => (
                  <li class="border-b border-carbon/15 last:border-b-0">
                    <a
                      href={`/${a.categoria.slug}/${a.slug}`}
                      class="group flex items-start gap-3 py-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-celeste"
                    >
                      <div class="aspect-square w-[72px] shrink-0 overflow-hidden">
                        <SanityImage
                          image={a.imagenPrincipal}
                          sizes="72px"
                          widths={[72, 144, 216]}
                          aspectRatio={1}
                          class="h-full w-full object-cover"
                        />
                      </div>
                      <div class="min-w-0 flex-1">
                        <p class="font-sans text-[10px] font-medium uppercase tracking-wider text-celeste-dark">
                          Judicial
                        </p>
                        <h4 class="mt-1 line-clamp-3 font-serif text-[14px] font-medium leading-[1.3] text-ink transition-colors duration-150 group-hover:text-celeste-dark sm:text-[15px]">
                          {a.titulo}
                        </h4>
                        <time
                          datetime={a.fechaPublicacion}
                          class="mt-1 block font-sans text-[11px] text-carbon/70"
                        >
                          {fechaCorta(a.fechaPublicacion)}
                        </time>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>
      </div>
    </section>
  )
}
