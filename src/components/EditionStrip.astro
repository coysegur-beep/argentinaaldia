---
interface Props {
  headline: string;
  href: string;
}

const { headline, href } = Astro.props;
---

<div class="bg-celeste text-ink">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-3">
    <a href={href} class="group flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <span class="shrink-0 font-sans text-[11px] font-medium uppercase tracking-[0.18em] text-ink/70">
        Edición de hoy
      </span>
      <span class="font-serif text-base leading-snug decoration-1 underline-offset-4 group-hover:underline sm:text-lg">
        {headline}
      </span>
    </a>
  </div>
</div>
