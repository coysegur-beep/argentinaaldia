---
// TODO Fase 5+: Migrar a @portabletext/to-html cuando entren bloques reales de Sanity
// (imagen con caption, cita, embeds de Twitter/YouTube, marks anidadas).
// Razón actual: para samples de desarrollo el renderer custom de 30 líneas alcanza.
// El cambio requiere instalar @portabletext/to-html + custom serializers.
// Ver TECH_DEBT.md para detalles.
import type { ContentBlock } from '../types';
import SanityImage from './SanityImage.astro';

interface Props {
  blocks: ContentBlock[];
}

const { blocks } = Astro.props;

function blockText(b: Extract<ContentBlock, { _type: 'block' }>): string {
  return b.children.map((c) => c.text).join('');
}
---

{
  blocks.map((block) => {
    if (block._type === 'block') {
      const text = blockText(block);
      if (block.style === 'h2') {
        return (
          <h2 class="mb-3 mt-10 font-serif text-2xl leading-snug text-ink sm:text-3xl">
            {text}
          </h2>
        );
      }
      if (block.style === 'h3') {
        return (
          <h3 class="mb-3 mt-8 font-serif text-xl leading-snug text-ink">
            {text}
          </h3>
        );
      }
      if (block.style === 'blockquote') {
        return (
          <blockquote class="my-6 border-l-4 border-celeste pl-6 font-serif text-lg italic leading-relaxed text-ink">
            {text}
          </blockquote>
        );
      }
      return (
        <p class="mb-5 font-serif text-lg leading-relaxed text-carbon">
          {text}
        </p>
      );
    }

    if (block._type === 'image') {
      return (
        <figure class="my-8">
          <SanityImage
            image={block}
            sizes="(max-width: 768px) 100vw, 768px"
            widths={[400, 600, 800, 1200, 1600]}
            class="block h-auto w-full"
          />
          {block.caption && (
            <figcaption class="mt-2 font-sans text-xs text-carbon/70">
              {block.caption}
            </figcaption>
          )}
        </figure>
      );
    }

    if (block._type === 'quote') {
      return (
        <figure class="my-8 border-l-4 border-celeste pl-6">
          <blockquote class="font-serif text-xl italic leading-relaxed text-ink sm:text-2xl">
            "{block.text}"
          </blockquote>
          {block.cite && (
            <figcaption class="mt-3 font-sans text-[11px] uppercase tracking-[0.18em] text-carbon/70">
              — {block.cite}
            </figcaption>
          )}
        </figure>
      );
    }

    if (block._type === 'tweet') {
      return (
        <div class="my-8 border border-ink/10 bg-bone p-4">
          <p class="font-sans text-xs uppercase tracking-widest text-carbon/60">
            Tweet embebido
          </p>
          <a
            href={block.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block break-all font-sans text-sm text-celeste-dark underline underline-offset-4"
          >
            {block.url}
          </a>
        </div>
      );
    }

    return null;
  })
}
