---
import type { Article } from '../types';
import SanityImage from './SanityImage.astro';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const items = articles.slice(0, 3);
const count = items.length;

// Grid simétrico: todas las cards con el mismo tamaño.
//   count=3 → grid-cols-3 (cada card 1/3 del ancho)
//   count=2 → grid-cols-2 (cada card 1/2, sin col vacía)
//   count=1 → 1 sola card centrada con max-w acotado (no ocupa ancho completo)
let outerClass = '';
let gridClass = '';
if (count === 3) {
  gridClass = 'grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10';
} else if (count === 2) {
  gridClass = 'grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-10';
} else {
  // count === 1
  outerClass = 'mx-auto max-w-md';
  gridClass = 'grid grid-cols-1';
}
---

{
  count > 0 && (
    <section class="bg-bone py-12 sm:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="mb-6 font-sans text-[12px] font-medium uppercase tracking-widest text-celeste-dark">
          Destacadas
        </p>
        <div class={outerClass}>
          <div class={gridClass}>
            {items.map((a) => (
              <article>
                <a href={`/${a.categoria.slug}/${a.slug}`} class="group block">
                  <div class="relative overflow-hidden">
                    <SanityImage
                      image={a.imagenPrincipal}
                      sizes={count === 1
                        ? '(max-width: 768px) 100vw, 28rem'
                        : count === 2
                          ? '(max-width: 768px) 100vw, 50vw'
                          : '(max-width: 768px) 100vw, 33vw'}
                      widths={[320, 480, 640, 800]}
                      aspectRatio={16 / 9}
                      class="block h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
                    />
                    <span
                      class="absolute bottom-3 left-3 inline-block px-3 py-1 font-sans text-[11px] font-medium uppercase tracking-wider text-white"
                      style={`background-color: ${a.categoria.colorAccent}`}
                    >
                      {a.categoria.nombre}
                    </span>
                  </div>
                  <h3
                    style={`color: ${a.categoria.colorAccent}`}
                    class="mt-4 line-clamp-3 font-serif text-[16px] font-medium leading-[1.3] transition-opacity group-hover:opacity-80 sm:text-[18px] lg:text-[20px]"
                  >
                    {a.titulo}
                  </h3>
                  <p class="mt-2 font-sans text-xs uppercase tracking-wider text-carbon">
                    {a.autor.nombre}
                  </p>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
