---
import type { Article } from '../types';
import { formatRelative } from '../lib/format';
import SanityImage from './SanityImage.astro';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const items = articles.slice(0, 3);
---

{
  items.length > 0 && (
    <section
      aria-labelledby="despachos-heading"
      class="bg-bone py-12 sm:py-16 lg:py-20"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="mb-10 sm:mb-12">
          <p class="font-sans text-[11px] font-medium uppercase tracking-widest text-celeste-dark">
            Última hora
          </p>
          <div class="mt-1 flex items-baseline justify-between gap-4">
            <h2
              id="despachos-heading"
              class="font-serif text-[28px] font-normal text-ink sm:text-[36px] lg:text-[40px]"
            >
              Despachos
            </h2>
            <a
              href="/buscar"
              aria-label="Ver todas las notas de última hora"
              class="shrink-0 font-sans text-[11px] font-medium uppercase tracking-wider text-carbon transition-colors hover:text-celeste-dark"
            >
              Ver todas →
            </a>
          </div>
        </header>

        <div class="grid grid-cols-1 gap-y-8 md:grid-cols-3 md:gap-x-8 lg:gap-y-12">
          {items.map((a) => (
            <article>
              <a
                href={`/${a.categoria.slug}/${a.slug}`}
                style={`--accent: ${a.categoria.colorAccent}`}
                class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-celeste"
              >
                <div class="relative overflow-hidden">
                  <SanityImage
                    image={a.imagenPrincipal}
                    sizes="(max-width: 768px) 100vw, 33vw"
                    widths={[320, 480, 640, 800]}
                    aspectRatio={16 / 9}
                    class="block h-auto w-full transition-transform duration-300 ease-out group-hover:scale-105"
                  />
                  <span
                    class="absolute bottom-3 left-3 inline-block px-3 py-1.5 font-sans text-[11px] font-medium uppercase tracking-widest text-white"
                    style={`background-color: ${a.categoria.colorAccent}`}
                  >
                    {a.categoria.nombre}
                  </span>
                </div>
                <h3 class="mt-4 font-serif text-[20px] font-medium leading-[1.25] text-ink transition-colors duration-150 group-hover:text-[var(--accent)] sm:text-[22px] lg:text-[26px]">
                  {a.titulo}
                </h3>
                <p class="mt-3 line-clamp-3 font-sans text-sm leading-relaxed text-carbon sm:text-[15px]">
                  {a.copete}
                </p>
                <p class="mt-4 font-sans text-[11px] font-medium uppercase tracking-wider text-carbon/70">
                  Por {a.autor.nombre} ·{' '}
                  <time datetime={a.fechaPublicacion}>
                    {formatRelative(a.fechaPublicacion)}
                  </time>
                </p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
