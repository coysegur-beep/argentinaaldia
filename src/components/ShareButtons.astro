---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const enc = encodeURIComponent;

const wa = `https://wa.me/?text=${enc(`${title} — ${url}`)}`;
const tw = `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
---

<div class="flex flex-wrap items-center gap-3 font-sans">
  <span class="mr-1 text-[11px] uppercase tracking-[0.18em] text-carbon/70">
    Compartir
  </span>

  <a
    href={wa}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Compartir en WhatsApp"
    class="flex h-9 w-9 items-center justify-center border border-ink/15 text-ink transition-colors hover:border-celeste-dark hover:text-celeste-dark"
  >
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.057 21.785h-.005a9.87 9.87 0 0 1-5.03-1.378l-.36-.214-3.741.982 1-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.436-9.884 9.89-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.89 9.884zm8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.47 3.488z"
      ></path>
    </svg>
  </a>

  <a
    href={tw}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Compartir en X (Twitter)"
    class="flex h-9 w-9 items-center justify-center border border-ink/15 text-ink transition-colors hover:border-celeste-dark hover:text-celeste-dark"
  >
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
      ></path>
    </svg>
  </a>

  <a
    href={fb}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Compartir en Facebook"
    class="flex h-9 w-9 items-center justify-center border border-ink/15 text-ink transition-colors hover:border-celeste-dark hover:text-celeste-dark"
  >
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M22 12.06C22 6.48 17.52 2 11.94 2S2 6.48 2 12.06c0 5.02 3.66 9.18 8.45 9.94v-7.03H7.9v-2.91h2.55v-2.21c0-2.52 1.5-3.91 3.79-3.91 1.1 0 2.25.2 2.25.2v2.47h-1.27c-1.25 0-1.64.78-1.64 1.57v1.88h2.79l-.45 2.91h-2.34V22c4.78-.76 8.45-4.92 8.45-9.94z"
      ></path>
    </svg>
  </a>

  <button
    type="button"
    data-share-copy
    data-url={url}
    aria-label="Copiar link"
    class="group flex h-9 items-center gap-2 border border-ink/15 px-3 text-ink transition-colors hover:border-celeste-dark hover:text-celeste-dark data-[copied=true]:border-celeste-dark data-[copied=true]:text-celeste-dark"
  >
    <svg
      class="h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
      ></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
      ></path>
    </svg>
    <span class="text-xs font-medium" data-share-copy-label>
      Copiar link
    </span>
  </button>
</div>

<script is:inline>
  document.querySelectorAll('[data-share-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      const label = btn.querySelector('[data-share-copy-label]');
      if (!url || !label) return;
      try {
        await navigator.clipboard.writeText(url);
        const original = label.textContent;
        label.textContent = '¡Copiado!';
        btn.setAttribute('data-copied', 'true');
        setTimeout(() => {
          label.textContent = original;
          btn.removeAttribute('data-copied');
        }, 1500);
      } catch (err) {
        console.error('No se pudo copiar el link', err);
      }
    });
  });
</script>
