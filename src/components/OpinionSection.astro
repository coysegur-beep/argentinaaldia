---
import type { Article } from '../types';
import SanityImage from './SanityImage.astro';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const items = articles.slice(0, 3);
---

{
  items.length > 0 && (
    <section
      aria-labelledby="opinion-heading"
      class="bg-white py-12"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 id="opinion-heading" class="sr-only">
          Opinión
        </h2>
        <div class="mb-8 flex items-center justify-between gap-4 sm:mb-10">
          <p class="font-sans text-[12px] font-medium uppercase tracking-widest text-celeste-dark sm:text-[13px]">
            Opinión
          </p>
          <a
            href="/buscar?q=opinion"
            class="font-sans text-[11px] font-medium uppercase tracking-wider text-carbon transition-colors duration-150 hover:text-celeste-dark sm:text-[12px]"
          >
            Todos los columnistas →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-y-8 md:grid-cols-3 md:gap-x-8 lg:gap-x-10">
          {items.map((a) => (
            <article class="border-l-2 border-celeste pl-4 sm:pl-5">
              <div class="mb-3 flex items-center gap-3">
                <SanityImage
                  image={{
                    src: a.autor.foto,
                    alt: `Foto de ${a.autor.nombre}`,
                  }}
                  sizes="(max-width: 1024px) 100vw, 96px"
                  widths={[96, 144, 192]}
                  aspectRatio={1}
                  class="h-11 w-11 shrink-0 rounded-full object-cover"
                />
                <div class="font-sans leading-tight">
                  <p class="text-[14px] font-medium text-ink sm:text-[15px]">
                    {a.autor.nombre}
                  </p>
                  <p class="mt-0.5 text-[11px] uppercase tracking-wider text-carbon">
                    {a.autor.cargo}
                  </p>
                </div>
              </div>
              <a
                href={`/${a.categoria.slug}/${a.slug}`}
                class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-celeste"
              >
                <h3 class="mb-2 line-clamp-3 font-serif text-[16px] font-medium italic leading-[1.3] text-ink transition-colors duration-150 group-hover:text-celeste-dark sm:text-[18px] lg:text-[20px]">
                  “{a.titulo}”
                </h3>
                <p class="line-clamp-2 font-sans text-[13px] leading-relaxed text-carbon sm:text-[14px]">
                  {a.copete}
                </p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
