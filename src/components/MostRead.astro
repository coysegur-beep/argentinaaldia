---
import type { Article, CategorySlug } from '../types';
import { formatDate } from '../lib/format';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const items = articles.slice(0, 5);

// Versiones más claras de los colorAccents para fondo ink (#0A0A0A).
// Todos calculados con contraste WCAG AA contra ink (>4.5:1). Solo se usan
// en este bloque por ahora; si aparecen otros bloques sobre fondo oscuro,
// extraer a src/lib/colors.ts y reusar.
const darkAccent: Record<CategorySlug, string> = {
  politica: '#FF6B6B',
  economia: '#6BB4FF',
  sociedad: '#8FD15B',
  cultura: '#9F95E0',
  deportes: '#56C8A8',
  agro: '#D49A45',
  espectaculos: '#E0689A',
  mundo: '#B0B0AC',
  provincias: '#C49A6E',
};

function fechaCorta(iso: string): string {
  return formatDate(iso, {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
}
---

{
  items.length > 0 && (
    <section
      aria-labelledby="masleido-heading"
      class="bg-ink py-20 sm:py-24"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="mb-8 text-center">
          <p class="font-sans text-[11px] font-medium uppercase tracking-widest text-sol sm:text-[12px]">
            Ranking del día
          </p>
          <h2
            id="masleido-heading"
            class="mt-2 font-sans text-[36px] font-bold uppercase leading-none tracking-tight text-white sm:text-[48px] lg:text-[64px]"
          >
            Lo más leído
          </h2>
        </header>

        <div
          class="mb-12 h-px w-full bg-sol/70 sm:mb-16"
          aria-hidden="true"
        />

        <ol
          aria-label="Ranking de notas más leídas"
          class="lg:grid lg:grid-cols-5 lg:gap-x-6 lg:gap-y-16"
        >
          {items.map((a, idx) => {
            const num = String(idx + 1).padStart(2, '0');
            const tagColor = darkAccent[a.categoria.slug];
            return (
              <li class="border-b border-white/15 py-10 first:pt-0 last:border-b-0 last:pb-0 lg:border-b-0 lg:p-0">
                <article>
                  <a
                    href={`/${a.categoria.slug}/${a.slug}`}
                    class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sol"
                  >
                    <span
                      aria-hidden="true"
                      class="block font-serif text-[36px] font-medium italic leading-none tabular-nums text-sol sm:text-[48px] lg:text-[56px]"
                    >
                      {num}
                    </span>
                    <span
                      class="mt-4 block font-sans text-[11px] font-medium uppercase tracking-wider"
                      style={`color: ${tagColor}`}
                    >
                      {a.categoria.nombre}
                    </span>
                    <h3 class="mt-2 line-clamp-4 font-sans text-[16px] font-semibold leading-[1.3] text-white transition-colors duration-150 group-hover:text-sol lg:text-[18px]">
                      {a.titulo}
                    </h3>
                    <time
                      datetime={a.fechaPublicacion}
                      class="mt-3 block font-sans text-[11px] text-white/60 sm:text-[12px]"
                    >
                      {fechaCorta(a.fechaPublicacion)}
                    </time>
                  </a>
                </article>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )
}
