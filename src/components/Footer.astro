---
const year = new Date().getFullYear();

const legal = [
  { href: '/terminos', label: 'Términos y condiciones' },
  { href: '/privacidad', label: 'Política de privacidad' },
  { href: '/cookies', label: 'Cookies' },
  { href: '/etica', label: 'Código de ética' },
  { href: '/correcciones', label: 'Correcciones' },
];

const eyebrowClass =
  'font-sans text-[11px] font-medium uppercase tracking-widest text-celeste sm:text-[12px]';
---

<footer class="bg-ink text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-3 lg:gap-x-12 xl:gap-x-16">
      <div class="space-y-4">
        <a
          href="/"
          class="block font-serif text-3xl leading-none tracking-tight text-white"
        >
          Argentina <span class="text-celeste">al día</span>
        </a>
        <p class="font-sans text-sm leading-relaxed text-white/70">
          Las noticias de Argentina, todos los días. Periodismo independiente,
          federal y editado.
        </p>
        <p
          class="font-sans text-[11px] uppercase tracking-widest text-white/50"
        >
          SSL · Privacidad
        </p>
      </div>

      {/*
        TODO Pre-launch: implementar form funcional cuando se decida sistema de newsletter.
        Opciones evaluadas: Mailchimp, Beehiiv, Substack, ConvertKit.
        Sin form, el headline "en tu casilla a las 7 AM" es promesa sin acción —
        considerar reescribir copy si el form no se implementa antes del lanzamiento.
      */}
      <div id="newsletter">
        <p class={eyebrowClass}>Newsletter diario</p>
        <h3
          class="mt-3 font-serif text-[20px] font-medium leading-[1.3] text-white sm:text-[22px] lg:text-[24px]"
        >
          La Argentina del día, en tu casilla a las 7 AM
        </h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-white/70">
          Lo que pasó, lo que importa y lo que viene. Sin ruido, sin clickbait.
          Resumen editorial gratuito, todos los días hábiles.
        </p>
      </div>

      <div>
        <h3 class={eyebrowClass}>Legal</h3>
        <ul class="mt-3 space-y-2 font-sans text-sm">
          {
            legal.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-white/80 transition-colors hover:text-celeste"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p
        class="font-sans text-[11px] uppercase tracking-widest text-white/50"
      >
        © {year} Argentina al día. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="https://x.com/Argentinal_Dia"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Argentina al día en X"
          class="text-white/60 transition-colors hover:text-celeste"
        >
          <svg
            class="h-5 w-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/argentinal_dia"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Argentina al día en Instagram"
          class="text-white/60 transition-colors hover:text-celeste"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/share/18d8cLQWJN/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Argentina al día en Facebook"
          class="text-white/60 transition-colors hover:text-celeste"
        >
          <svg
            class="h-5 w-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M22 12.06C22 6.48 17.52 2 11.94 2S2 6.48 2 12.06c0 5.02 3.66 9.18 8.45 9.94v-7.03H7.9v-2.91h2.55v-2.21c0-2.52 1.5-3.91 3.79-3.91 1.1 0 2.25.2 2.25.2v2.47h-1.27c-1.25 0-1.64.78-1.64 1.57v1.88h2.79l-.45 2.91h-2.34V22c4.78-.76 8.45-4.92 8.45-9.94z"
            ></path>
          </svg>
        </a>
        <a
          href="/feed.xml"
          aria-label="RSS"
          class="text-white/60 transition-colors hover:text-celeste"
        >
          <svg
            class="h-5 w-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M6.18 17.82a2.18 2.18 0 1 0 0 4.36 2.18 2.18 0 0 0 0-4.36zM4 4.44v3.13c8.06 0 14.43 6.37 14.43 14.43H22C22 12.13 13.87 4.44 4 4.44zm0 6.27v3.13c4.5 0 8.16 3.66 8.16 8.16h3.13c0-6.23-5.06-11.29-11.29-11.29z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
