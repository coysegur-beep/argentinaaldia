---
import { formatDate } from '../lib/format';
import { categories } from '../data/content';

interface Props {
  fecha: Date;
  numeroEdicion: number;
}

const { fecha, numeroEdicion } = Astro.props;

const fechaLarga = formatDate(fecha, {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const seccionesLinks = categories.slice().sort((a, b) => a.orden - b.orden);

const directorio: { label: string; items: { href: string; label: string }[] }[] = [
  {
    label: 'Compañía',
    items: [
      { href: '/sobre', label: 'Sobre Argentina al día' },
      { href: '/contacto', label: 'Contacto' },
    ],
  },
];

const linkClass =
  'block py-1 font-sans text-base text-ink transition-colors hover:text-celeste-dark';
const labelClass =
  'mb-4 font-sans text-[11px] font-medium uppercase tracking-widest text-celeste-dark';
---

<header class="relative bg-ink text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
    <div class="grid grid-cols-2 md:grid-cols-3 items-center gap-x-4 gap-y-5">
      <div class="flex flex-col font-sans text-[11px] uppercase tracking-[0.18em] leading-tight text-white/60">
        <time datetime={fecha.toISOString()} class="text-white/85">{fechaLarga}</time>
        <span class="mt-1">Edición N.º {numeroEdicion}</span>
      </div>

      <a
        href="/"
        aria-label="Argentina al día — Portada"
        class="order-3 col-span-2 block text-center font-serif text-white leading-none tracking-tight md:order-none md:col-span-1"
      >
        <span class="text-[34px] md:text-[42px]">
          Argentina <span class="text-celeste">al día</span>
        </span>
      </a>

      <div class="flex items-center justify-end gap-4 font-sans text-sm md:gap-5">
        <button
          type="button"
          aria-expanded="false"
          aria-controls="header-menu-panel"
          data-menu-toggle
          class="font-sans text-[14px] font-medium uppercase tracking-wider text-white transition-colors hover:text-celeste"
        >
          Menú
        </button>

        <button
          type="button"
          aria-label="Buscar"
          aria-expanded="false"
          aria-controls="header-search-panel"
          data-search-toggle
          class="-m-1 p-1 text-white/70 transition-colors hover:text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="header-search-panel"
    data-search-panel
    inert
    class="pointer-events-none absolute inset-x-0 top-full z-30 -translate-y-1 border-b border-ink/10 bg-white opacity-0 shadow-md transition-all duration-200 ease-out data-[open]:pointer-events-auto data-[open]:translate-y-0 data-[open]:opacity-100"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <form
        action="/buscar"
        method="get"
        data-search-form
        class="flex items-center gap-2 sm:gap-3"
      >
        <label for="header-search-input" class="sr-only">
          Buscar notas, autores o temas
        </label>
        <input
          id="header-search-input"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Buscar notas, autores, temas…"
          data-search-input
          class="min-w-0 flex-1 border border-ink/15 bg-white px-4 py-3 font-sans text-base text-ink placeholder:text-carbon/50 focus:border-celeste-dark focus:outline-none"
        />
        <button
          type="submit"
          class="shrink-0 bg-celeste px-4 py-3 font-sans text-sm font-medium text-ink transition-colors hover:bg-celeste-dark hover:text-white sm:px-5"
        >
          Buscar
        </button>
        <button
          type="button"
          aria-label="Cerrar buscador"
          data-search-close
          class="shrink-0 -m-1 p-2 text-carbon/60 transition-colors hover:text-ink"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path d="M18 6L6 18"></path>
            <path d="M6 6l12 12"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>

  <div
    id="header-menu-panel"
    data-menu-panel
    inert
    class="pointer-events-none absolute inset-x-0 top-full z-30 max-h-[80vh] -translate-y-1 overflow-y-auto border-b border-carbon/20 bg-bone opacity-0 shadow-md transition-all duration-200 ease-out data-[open]:pointer-events-auto data-[open]:translate-y-0 data-[open]:opacity-100"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-12">
        <div>
          <h3 class={labelClass}>Secciones</h3>
          <ul class="space-y-3">
            {
              seccionesLinks.map((c) => (
                <li>
                  <a href={`/${c.slug}`} class={linkClass}>
                    {c.nombre}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {
          directorio.map((col) => (
            <div>
              <h3 class={labelClass}>{col.label}</h3>
              <ul class="space-y-3">
                {col.items.map((it) => (
                  <li>
                    <a href={it.href} class={linkClass}>
                      {it.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function isOpen(el) {
      return el && el.hasAttribute('data-open');
    }
    function show(panel, toggle) {
      panel.setAttribute('data-open', '');
      panel.removeAttribute('inert');
      toggle.setAttribute('aria-expanded', 'true');
    }
    function hide(panel, toggle) {
      panel.removeAttribute('data-open');
      panel.setAttribute('inert', '');
      toggle.setAttribute('aria-expanded', 'false');
    }

    const searchToggle = document.querySelector('[data-search-toggle]');
    const searchPanel = document.querySelector('[data-search-panel]');
    const searchClose = document.querySelector('[data-search-close]');
    const searchInput = document.querySelector('[data-search-input]');

    const menuToggle = document.querySelector('[data-menu-toggle]');
    const menuPanel = document.querySelector('[data-menu-panel]');

    function closeSearch(returnFocus) {
      if (!isOpen(searchPanel)) return;
      hide(searchPanel, searchToggle);
      if (returnFocus !== false) searchToggle.focus();
    }
    function openSearch() {
      closeMenu(false);
      show(searchPanel, searchToggle);
      try {
        const q = new URL(window.location.href).searchParams.get('q');
        if (q !== null) searchInput.value = q;
      } catch (_) {}
      requestAnimationFrame(function () {
        searchInput.focus();
        searchInput.select();
      });
    }

    function closeMenu(returnFocus) {
      if (!isOpen(menuPanel)) return;
      hide(menuPanel, menuToggle);
      if (returnFocus !== false) menuToggle.focus();
    }
    function openMenu() {
      closeSearch(false);
      show(menuPanel, menuToggle);
      requestAnimationFrame(function () {
        const firstLink = menuPanel.querySelector('a');
        if (firstLink) firstLink.focus();
      });
    }

    if (searchToggle && searchPanel) {
      searchToggle.addEventListener('click', function () {
        isOpen(searchPanel) ? closeSearch() : openSearch();
      });
      if (searchClose) searchClose.addEventListener('click', function () {
        closeSearch();
      });
    }
    if (menuToggle && menuPanel) {
      menuToggle.addEventListener('click', function () {
        isOpen(menuPanel) ? closeMenu() : openMenu();
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (isOpen(searchPanel)) closeSearch();
      else if (isOpen(menuPanel)) closeMenu();
    });

    document.addEventListener('click', function (e) {
      const t = e.target;
      if (isOpen(searchPanel) && !searchPanel.contains(t) && !searchToggle.contains(t)) {
        closeSearch(false);
      }
      if (isOpen(menuPanel) && !menuPanel.contains(t) && !menuToggle.contains(t)) {
        closeMenu(false);
      }
    });

    function trapFocus(panel) {
      if (!panel) return;
      panel.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab' || !isOpen(panel)) return;
        const f = panel.querySelectorAll(
          'a, button, input, [href], [tabindex]:not([tabindex="-1"])',
        );
        if (f.length === 0) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }
    trapFocus(searchPanel);
    trapFocus(menuPanel);
  })();
</script>
